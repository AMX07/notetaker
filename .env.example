# Required: OpenAI API key for Whisper transcription
# OPENAI_API_KEY=

# Option A: Direct Anthropic API
# ANTHROPIC_API_KEY=

# Option B: AWS Bedrock (set these instead of ANTHROPIC_API_KEY)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional: Set a password to protect the web UI (HTTP Basic Auth)
# Leave blank or unset to disable auth
# NOTETAKER_PASSWORD=your-secret-password
